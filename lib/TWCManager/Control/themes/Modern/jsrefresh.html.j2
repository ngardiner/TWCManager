<script>

    // Live values: live.js fills the data-* hooks; this hook carries what is
    // not plain text (colours, buttons, help texts) and the navbar's server time.
    var POLICY_ACTIONS = {
        3: ["#policy_solar", "#helpTextSolar"],
        1: ["#policy_fixed", "#helpTextFixed"],
        2: ["#policy_dont", "#helpTextDont"]
    };

    Live.onData(function (data) {
        var generation = parseFloat(data.generationWatts);
        var consumption = parseFloat(data.consumptionWatts);

        // color consumption green, as it is fully covered by solar
        $('#consumptionWatts').css('color', generation > consumption ? 'green' : 'black');

        // Change the state of the Charge Now button based on Charge Policy
        var chargeNow = data.currentPolicy == "Charge Now";
        $("#start_chargenow").text(chargeNow ? "Update Charge Now" : "Charge Now");
        $("#cancel_chargenow").prop("disabled", !chargeNow).toggleClass("disabled", !chargeNow);

        if (data.chargeNowAmps !== "" && data.chargeNowAmps > 0) {
            $('#chargeNowAmpsText').text("Currently: " + data.chargeNowAmps + "A");
        } else {
            $('#chargeNowAmpsText').text("");
        }
        var endText = $('#chargeNowTimeEndText').empty();
        if (data.chargeNowTimeEnd !== "" && data.chargeNowTimeEnd > 0) {
            var endDTM = new Date(1000 * data.chargeNowTimeEnd);
            var endMinutes = Math.floor((data.chargeNowTimeEnd - data.now) / 60);
            endText.append(
                document.createTextNode("Ending: " + endDTM.toLocaleString()),
                document.createElement("br"),
                document.createTextNode("(" + endMinutes + " minutes remaining)")
            );
        }

        // change the state of the Charge Policy display buttons based on Charge Policy Action
        var action = data.activePolicyAction;
        if (POLICY_ACTIONS.hasOwnProperty(action)) {
            Object.keys(POLICY_ACTIONS).forEach(function (key) {
                var active = key == action;
                $(POLICY_ACTIONS[key][0]).toggleClass("btn-primary", active).toggleClass("btn-outline-primary", !active);
                $(POLICY_ACTIONS[key][1]).toggle(active);
            });
        } else {
            // TWCmanager (re)started and policy not yet initialized?
            console.log('unknown policy action "' + action + '"');
        }

        var serverTime = document.getElementById("currentServerTime");
        if (serverTime && data.currentServerTime != null) {
            serverTime.textContent = data.currentServerTime.split("&nbsp;").join(" ");
        }
    });

    Live.start({
        urls: ["/api/getStatus", "/api/getChargingPoints", ["/api/getActivePolicyAction", "activePolicyAction"]],
        interval: 3000,
        fingerprint: {{ fingerprint("home")|tojson }}
    });

    $(document).ready(function() {
        $("#start_chargenow").click(function(e) {
            e.preventDefault();
            // submit charge command via AJAX
            $.ajax({
                type: "POST",
                url: "/api/chargeNow",
                data: JSON.stringify({
                    chargeNowRate: $("#chargeNowRate").val(),
                    chargeNowDuration: ($("#chargeNowDuration").val()*60*60)
                }),
                dataType: "json"
            }).done( function(data) {
                console.log('Starting to charge now!');
                $(this).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>Update charging');
            });
        });
    });

</script>
