<!DOCTYPE html>
<html lang='en'>
  <head>
    <title>TWCManager</title>
    {% include 'bootstrap.html.j2' %}
    <script type="text/javascript" src="/static/js/settings.js"></script>
    <script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css" />
    <style>
      html, body {
        height: 100%;
        padding: 0;
        margin: 0;
      }
      #map {
        /* configure the size of the map */
        width: 50%;
        height: 50%;
      }
    </style>
  </head>
  <body>
    {% include 'navbar.html.j2' %}
    <form method=POST action='/settings/save'>
      <table>
        <tr>
          <th>Web Interface Theme</th>
          <td>
            {{ optionList(
              [
                ["Default", "Default Web Theme"],
                ["Modern", "Modern Theme"],
              ],
              {
                "name": "webControlTheme",
                "value": master.settings.get("webControlTheme", "Modern"),
              },
            )|safe }}
          </td>
        </tr>
        <tr>
          <th>Stop Charging Method</th>
          <td>
            {{ optionList(
              [
                [1, "Vehicle command (BLE or API)"],
                [2, "Stop Responding to Slaves"],
                [3, "Send Stop Command"],
              ],
              {
                "name": "chargeStopMode",
                "value": master.settings.get("chargeStopMode", 1),
              },
            )|safe }}
          </td>
        </tr>
        <tr>
          <th>Non-Scheduled power action:</th>
          <td>
            {{ optionList(
              [
                [1, "Charge at specified Non-Scheduled Charge Rate"],
                [2, "Do not Charge"],
                [3, "Track Green Energy"],
              ],
              {
                "name": "nonScheduledAction",
                "value": master.settings.get("nonScheduledAction", 1),
              },
            )|safe }}
          </td>
        </tr>
        <tr>
          <th>Non-scheduled power charge rate:</th>
          <td>
            {{ optionList(ampsList[1:],
                 {
                   "name": "nonScheduledAmpsMax",
                   "value": master.settings.get("nonScheduledAmpsMax", "6")
                 })|safe }}
          </td>
        </tr>
        <tr>
          <th>Include ServerTime in Main UI:</th>
          <td>
            {{ optionList(
              [
                [0, "Do not include Server Time"],
                [1, "Include Server Time"],
              ],
              {
                "name": "sendServerTime",
                "value": master.settings.get("sendServerTime", 0),
              },
            )|safe }}
          </td>
        </tr>
        <tr>
          <th>Charge Authorization Mode:</th>
          <td>
            {{ optionList(
              [
                [1, "Vehicles can charge unless explictly blocked"],
                [2, "Vehicles can only charge if explicitly allowed"],
              ],
              {
                "name": "chargeAuthorizationMode",
                "value": master.settings.get("chargeAuthorizationMode", "1")
              })|safe }}
          </td>
        </tr>
        <tr>
          <th>Charge Rate Control:</th>
          <td>
            {{ optionList(
              [
                [1, "Use TWC exclusively to control charge rate"],
                [2, "Use a vehicle command (BLE or API) exclusively to control charge rate"],
                [3, "Use TWC >= 6A + vehicle command (BLE or API) < 6A"],
              ],
              {
                "name": "chargeRateControl",
                "value": master.settings.get("chargeRateControl", "1")
              })|safe }}
          </td>
        </tr>
        <tr>
          <th>Vehicle Command Policy:</th>
          <td>
            {% set configPolicy = master.config.get("vehicle", {}).get("commandPolicy") %}
            {% if configPolicy %}
              Hard-set to <b>{{ configPolicy }}</b> via commandPolicy in
              config.json. Remove it from config.json to control this setting
              here instead.
            {% else %}
            {{ optionList(
              [
                ["prefer_ble", "Prefer local (BLE), fall back to cloud"],
                ["ble_only", "Local only - never send billed cloud commands"],
                ["api_only", "Cloud only - never use BLE"],
              ],
              {
                "name": "commandPolicy",
                "value": master.settings.get("commandPolicy", "prefer_ble")
              })|safe }}
            {% endif %}
          </td>
        </tr>
        <tr>
          <th>Consumption Offsets</th>
          <td>
            <table id="consumptionOffsets">
              <thead>
                <tr>
                  <th>Offset Name</th>
                  <th>Offset</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
              </tbody>
              <thead>
                <tr>
                  <td><input type="text" class='form-control' id="offsetName" size=8 value="Name"></td>
                  <td><input type="text" class='form-control' id="offsetValue" size=3 value="0" /></td>
                  <td>
                    {{ optionList(
                      [
                        ["A", "Amps"],
                        ["W", "Watts"],
                      ],
                      {
                        "name": "offsetUnit",
                    })|safe }}
                    </td>
                    <td>
                    {{ addButton(
                      ["addOffset", "Add / Edit", { "buttonType": "button" }],
                      "class='btn btn-outline-success'",
                      )|safe }}
                  </td>
                </tr>
              </thead>
            </table>
          </td>
        </tr>
        {% set carapi = master.getModuleByName("TeslaAPI") %}
        {% if carapi %}
        {% for slotName, label in [("owner", "Owner API token"), ("fleet", "Fleet API token")] %}
        {% set status = (carapi.ownerSlot if slotName == "owner" else carapi.fleetSlot).status() %}
        <tr>
          <th>{{ label }}:</th>
          <td>
            {% if status.holdsToken %}
              expires {{ status.expires }}
              ({{ {"synced": "synced from TeslaMate", "pasted": "pasted", "login": "Fleet API login"}.get(status.source, status.source) }})
              {% if status.paused %}<em>paused for reads</em>{% endif %}
              <button class='btn btn-outline-danger btn-sm' type='submit' form='removeToken-{{ slotName }}'>Remove token</button>
            {% else %}
              none
            {% endif %}
          </td>
        </tr>
        {% endfor %}
        {% endif %}
        <tr>
          <th>Manual Tesla API key override (<a href="http://registration.teslatasks.com/generateTokens" target="_blank">link</a>):</th>
          <td>
            <table>
              <tr>
                <th>Access Token</th>
                <th>Refresh Token</th>
              </tr>
              <tr>
                <td><input type='text' class='form-control' id='carApiBearerToken' name='carApiBearerToken' value='' /></td>
                <td><input type='text' class='form-control' id='carApiRefreshToken' name='carApiRefreshToken' value='' /></td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td>&nbsp;</td>
          <td><input class='btn btn-outline-success' type=submit value='Save Settings' /></td>
        </tr>
      </table>
    </form>
    {% if carapi %}
    {% for slotName in ["owner", "fleet"] %}
    <form id='removeToken-{{ slotName }}' method='post' action='/teslaAccount/removeToken'>
      <input type='hidden' name='slot' value='{{ slotName }}' />
    </form>
    {% endfor %}
    {% endif %}
    <p>Click <a href='https://github.com/ngardiner/TWCManager/tree/main/docs/Settings.md' target='_blank'>here</a> for detailed information on settings on this page</p>
  </div>

  <h2>Home Location</h2>

  <p>The following pins show the Home and Current Locations of your vehicle. If both are the same, you'll see a single pin.</p>
  <div id="map"></div>
    <script>
      // initialize Leaflet
      var map = L.map('map').setView({lon: {{ master.settings.get("homeLon", "0")}}, lat: {{ master.settings.get("homeLat", "0")}}}, 8);

      // add the OpenStreetMap tiles
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://openstreetmap.org/copyright">OpenStreetMap contributors</a>'
      }).addTo(map);

      // show the scale bar on the lower left corner
      L.control.scale({imperial: true, metric: true}).addTo(map);

      // show a marker on the map
      L.marker({lon: {{ master.settings.get("homeLon", "0")}}, lat: {{ master.settings.get("homeLat", "0")}}}).bindPopup('Home Location').addTo(map);
      {% for vehicle in locatedVehicles() %}
      L.marker({lon: {{ vehicle.value("lon") }}, lat: {{ vehicle.value("lat") }}}).bindPopup('{{ vehicle.name or vehicle.key }} Current Location').addTo(map);
      {% endfor %}
    </script>
    <ul>
      <li>The Home Location is {{ master.settings.get("homeLat", "0")}}, {{ master.settings.get("homeLon", "0")}} (latitude, longitude).</li>
      <li>If you unset the Home Location, it is learned again from a car's fresh position when a TWC identifies the car plugged in, or when the position arrives over Bluetooth. Without a TWC or Bluetooth, choose a vehicle below to make its current location the Home Location.</li>
    </ul>
    <form method=POST action='/settings/homeLocation'>
      <input class='btn btn-outline-success' type=submit name=unset value='Unset Home Location' />
      {% if locatedVehicles() %}
      <input class='btn btn-outline-success' type=submit name=learn value='Make Vehicle Location Home Location' />
      <select name=vehicle>
      {% for vehicle in locatedVehicles() %}
      <option value="{{ vehicle.value("lon") }},{{ vehicle.value("lat") }}">{{ vehicle.name or vehicle.key }}</option>
      {% endfor %}
      </select>
      {% endif %}
    </form>

</body>
</html>

