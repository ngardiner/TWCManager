<!DOCTYPE html>
<html lang='en'>
  <head>
    <title>TWCManager</title>
    {% include 'bootstrap.html.j2' %}
    <style>
      /* The gap the server-drawn rows got from a &nbsp; spacer column */
      table.live-rows td + td, table.live-rows th + th { padding-left: 0.75em; }
    </style>
    <script type="text/javascript" src="/static/js/compositor.js"></script>
    <script type="text/javascript" src="/static/js/vehicleImage.js"></script>
    {% set vin = url.path.split("/")[2] %}
    {% set regVehicle = registry.get(vin) %}
    {% if regVehicle %}
    <script type="text/javascript" src="/static/js/format.js"></script>
    <script type="text/javascript" src="/static/js/live.js"></script>
    <script type="text/javascript">
      Live.start({urls: [{{ ("/api/getVehicle/" ~ vin|urlencode)|tojson }}], interval: 5000, fingerprint: {{ fingerprint("vehicle", vin)|tojson }}});
    </script>
    {% endif %}
  </head>
  <body>
    {% include 'navbar.html.j2' %}
    <p>&nbsp;</p>
    <h3>Vehicle Details</h3>
    {% if regVehicle %}
    {% set row = regVehicle.summary() %}
    <img class="vehicleImage" hidden alt=""
         data-vin="{{ row.vin }}" data-appearance="{{ row.appearance|tojson|forceescape }}">
    <table>
      <tr>
        <th>Name</th><td>&nbsp;</td>
        <th>Providers</th><td>&nbsp;</td>
        <th>Last seen</th>
      </tr>
      <tr>
        <td data-field="vehicle.name"></td><td>&nbsp;</td>
        <td data-field="vehicle.providers" data-format="providerLines" style="white-space: pre-line"></td><td>&nbsp;</td>
        <td data-field="vehicle" data-format="lastSeen"></td>
      </tr>
    </table>
    {% if canForget(vin) %}
    <form method=POST action="/vehicle/forget">
      <input type=hidden name="vin" value="{{ vin }}" />
      <input type=submit value="Forget this vehicle">
      <small>Added by VIN and not seen by any provider. Removes it from this list; a key made when it was added goes too.</small>
    </form>
    {% endif %}
    <p>&nbsp;</p>
    <h3>Pending commands</h3>
    <table class="live-rows">
      <tbody data-list="vehicle.pending" data-row="pendingRow"></tbody>
    </table>
    <p data-show="vehicle.pending" data-show-if="isEmpty" hidden>Nothing pending</p>
    <div data-show="vehicle.spend" hidden>
    <p>&nbsp;</p>
    <h3>Fleet spend</h3>
    <p data-field="vehicle" data-format="spendHeading" data-show="vehicle" data-show-if="spendHeading"></p>
    <table class="live-rows" data-show="vehicle.spend.types">
      <thead><tr><th>Request</th><th>Count</th><th>Cost</th><th>Last</th></tr></thead>
      <tbody data-list="vehicle.spend.types" data-row="spendTypeRow"></tbody>
    </table>
    <div data-show="vehicle" data-show-if="spendTelemetry">
    <p data-field="vehicle" data-format="spendTelemetry"></p>
    <table class="live-rows">
      <thead><tr><th>Field</th><th>Signals</th></tr></thead>
      <tbody data-list="vehicle.spend.fields" data-row="fieldRow"></tbody>
    </table>
    </div>
    </div>
    <p>&nbsp;</p>
    {% endif %}
    {% if vin != "00000000000000000" %}
    <table>
        <tr>
          <th>Vehicle VIN</th>
          <td>{{ vin }}</td>
        </tr>
        <tr>
          <th>Manufacturer</th>
          <td>
            {% if vin[0:3] == "5YJ" or vin[0:3] == "LRW" %}
              Tesla Motors
            {% endif %}
          </td>
        </tr>
        <tr>
          <th>Manufacture Location</th>
          <td>
             {% if vin[10] == "F" %}Fremont, California, USA{%endif%}
             {% if vin[10] == "P" %}Palo Alto, California, USA{%endif%}
             {% if vin[10] == "C" %}Shanghai, China{%endif%}
          </td>
        </tr>
        <tr>
          <th>Model</th>
          <td>
            {% if vin[3] == "3" %}Model 3{%endif%}
            {% if vin[3] == "S" %}Model S{%endif%}
            {% if vin[3] == "X" %}Model X{%endif%}
            {% if vin[3] == "Y" %}Model Y{%endif%}
          </td>
        </tr>
        <tr>
          <th>Body Type</th>
          <td>
            {% if vin[3:5] == "SA" %}Left-Hand Drive{%endif%}
            {% if vin[3:5] == "SB" %}Right-Hand Drive{%endif%}
            {% if vin[3:5] == "XC" %}Left-Hand Drive{%endif%}
            {% if vin[3:5] == "XD" %}Right-Hand Drive{%endif%}
            {% if vin[3:5] == "3E" %}Left-Hand Drive{%endif%}
            {% if vin[3:5] == "3F" %}Right-Hand Drive{%endif%}
          </td>
        </tr>
        <tr>
          <th>Variant</th>
          <td>
            {% if vin[3] == "3" and vin[5:8] == "7EA" %}Standard Range Plus RWD{%endif%}
            {% if vin[3] == "3" and vin[5:8] == "7EB" %}Long Range AWD{%endif%}
            {% if vin[3] == "3" and vin[5:8] == "7EC" %}Performance AWD{%endif%}
            {% if vin[3] == "3" and vin[7] == "B" %}Long Range AWD{%endif%}
          </td>
        </tr>
        <tr>
          <th>Manufacture Year</th>
          <td>
            {% if vin[9] == "D" %}2013{%endif%}
            {% if vin[9] == "E" %}2014{%endif%}
            {% if vin[9] == "F" %}2015{%endif%}
            {% if vin[9] == "G" %}2016{%endif%}
            {% if vin[9] == "H" %}2017{%endif%}
            {% if vin[9] == "J" %}2018{%endif%}
            {% if vin[9] == "K" %}2019{%endif%}
            {% if vin[9] == "L" %}2020{%endif%}
            {% if vin[9] == "M" %}2021{%endif%}
          </td>
        </tr>
        <tr>
          <th>Charge Sessions</th>
          {% if regVehicle %}
          <td data-field="vehicle.chargeSessions"></td>
          {% else %}
          <td>{{ master.settings.get("Vehicles", {}).get(vin, {}).get("chargeSessions", 0) }}</td>
          {% endif %}
        </tr>
    </table>
    {% else %}
    <table>
      <tr>
        <th>Vehicle Details</th>
        <td>This VIN is assigned to non-Tesla vehicles which attempt to charge on a TWCManager managed TWC. You can use this VIN to determine if non-Tesla vehicles are able to charge.</td>
      </tr>
    </table>
    {% endif %}

    {% if regVehicle and 'TeslaBLE' in master.modules %}
    <div data-show="vehicle.ble" hidden>
      <p>&nbsp;</p>
      <h3>BLE Control</h3>
      <table>
        <tr>
          <th>Status</th>
          <td>
            <span data-field="vehicle.ble" data-format="bleLabel"></span>
            <span data-show="vehicle.ble.since" hidden><br/><small data-field="vehicle.ble" data-format="bleSince"></small></span>
          </td>
        </tr>
        <tr data-show="vehicle.ble.attempt" hidden>
          <th>Last pairing attempt</th>
          <td data-field="vehicle.ble" data-format="bleAttempt"></td>
        </tr>
        <tr>
          <th>Last scan</th>
          <td data-field="vehicle.ble" data-format="bleLastScan"></td>
        </tr>
        <tr>
          <th>Action</th>
          <td>
            <form method=POST action=/vehicle/localMgmt data-show="vehicle.ble.canScan" hidden>
              <input type=hidden name="operation" value="scan" />
              <input type=hidden name="vin" value="{{ vin }}" />
              <span data-show="vehicle.ble.scanPending" hidden><input type=submit value="Scanning…" disabled></span>
              <span data-show="vehicle.ble.scanPending" data-show-if="not" hidden><input type=submit value="Scan for vehicle"></span>
            </form>
            <small data-field="vehicle.ble" data-format="bleScanBlocked" data-show="vehicle.ble" data-show-if="bleScanBlocked" hidden></small>
            <form method=POST action=/vehicle/localMgmt>
              <input type=hidden name="operation" value="pair" />
              <input type=hidden name="vin" value="{{ vin }}" />
              <span data-show="vehicle.ble" data-show-if="bleRepair" hidden><input type=submit value="Re-pair with Vehicle"></span>
              <span data-show="vehicle.ble" data-show-if="bleNotRepair" hidden><input type=submit value="Pair with Vehicle"></span>
            </form>
          </td>
        </tr>
      </table>
    </div>
    {% endif %}

    <p>&nbsp;</p>
    <h3>Group Management</h3>
    <table>
      <tr>
        <th>Group</th>
        <th>Membership Status</th>
        <th>Actions</th>
      </tr>
      {% for group in master.settings["VehicleGroups"].keys()|sort %}
      <tr>
        <td><b>{{ group }}</b></td>
        <td>
          {% if vin in master.settings["VehicleGroups"][group]["Members"] %}
            Vehicle is in this group
          {% else %}
            Vehicle is not in this group
          {% endif %}
        </td>
        <td>
          {% if vin in master.settings["VehicleGroups"][group]["Members"] %}
            <form method=POST action=/vehicle/groupMgmt>
              <input type=hidden name="operation" value="remove" />
              <input type=hidden name="vin" value="{{vin}}" />
              <input type=hidden name="group" value="{{group}}" />
              <input type=submit value="Remove from Group">
            </form>
          {% else %}
            <form method=POST action=/vehicle/groupMgmt>
              <input type=hidden name="operation" value="add" />
              <input type=hidden name="vin" value="{{vin}}" />
              <input type=hidden name="group" value="{{group}}" />
              <input type=submit value="Add to Group">
            </form>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </table>
  </body>
</html>
