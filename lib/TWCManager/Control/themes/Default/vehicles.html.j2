<!DOCTYPE html>
<html lang='en'>
  <head>
    <title>TWCManager</title>
    {% include 'bootstrap.html.j2' %}
    <script type="text/javascript" src="/static/js/compositor.js"></script>
    <script type="text/javascript" src="/static/js/vehicleImage.js"></script>
    <script type="text/javascript" src="/static/js/format.js"></script>
    <script type="text/javascript" src="/static/js/live.js"></script>
    <script type="text/javascript">
      Live.start({urls: ["/api/getVehicles"], interval: 5000, fingerprint: {{ fingerprint("vehicles")|tojson }}});
    </script>
  </head>
  <body>
    {% include 'navbar.html.j2' %}
    <p>&nbsp;</p>
    <h3>Vehicles</h3>
    {% set fleet, telemetry = spendShown() %}
    {% set spend = fleet or telemetry %}
    <p data-field="spend" data-format="fleetLine" data-show="spend.fleet" hidden></p>
    <p data-field="spend" data-format="telemetryLine" data-show="spend.telemetry" hidden></p>
    <table class="stack">
      <tr>
        <th></th>
        <th>VIN</th>
        <th>Name</th>
        <th>Presence</th>
        <th>Watch</th>
        <th>Providers</th>
        <th>Last seen</th>
        <th>Charge limit (car's own)</th>
        {% if spend %}<th>Fleet this month</th>{% endif %}
      </tr>
      {% for v in registry.vehicles() %}
        {% set row = v.summary() %}
        <tr>
          <td class="picture">
            {% if not row.anonymous %}
            <a href="/vehicleDetail/{{ row.vin }}"><img class="vehicleImage thumbnail" hidden alt=""
                 data-vin="{{ row.vin }}" data-appearance="{{ row.appearance|tojson|forceescape }}"></a>
            {% endif %}
          </td>
          <td data-label="VIN">
            {% if row.anonymous %}Unknown car on TWC {{ row.point }}
            {% else %}<a href="/vehicleDetail/{{ row.vin }}">{{ row.vin }}</a>{% endif %}
          </td>
          <td data-label="Name" data-field="vehicles.{{ loop.index0 }}.name"></td>
          <td data-label="Presence" data-field="vehicles.{{ loop.index0 }}.presence" data-format="presence"></td>
          <td data-label="Watch" data-field="vehicles.{{ loop.index0 }}.watch" data-format="watchLine"></td>
          <td data-label="Providers" data-field="vehicles.{{ loop.index0 }}.providers" data-format="providerLines" style="white-space: pre-line"></td>
          <td data-label="Last seen" data-field="vehicles.{{ loop.index0 }}" data-format="lastSeen"></td>
          <td data-label="Charge limit (car's own)" data-field="vehicles.{{ loop.index0 }}.heldLimit" data-format="heldLimit"></td>
          {% if spend %}<td data-label="Fleet this month" data-field="vehicles.{{ loop.index0 }}" data-format="spendCell"></td>{% endif %}
        </tr>
      {% endfor %}
    </table>

    {% if addVehicleError %}
    <p style="color: red;">{{ addVehicleError }}</p>
    {% endif %}
    <form method=POST action="/vehicle/add">
      <b>Add vehicle by VIN</b>
      <input name="vin" maxlength="17" />
      <input type=submit value="Add vehicle" />
    </form>

    <p>&nbsp;</p>
    <h3>Charge history</h3>
    <table class="stack">
        <tr>
          <th>Vehicle VIN</th>
          <th>Charges</th>
          <th>Total kWh</th>
        </tr>
      {% if master.settings["Vehicles"] %}
        {% for vehicle in master.settings["Vehicles"].keys()|sort %}
            <tr>
              <td data-label="VIN"><a href="/vehicleDetail/{{ vehicle }}">{{ vehicle }}</a></td>
              <td data-label="Charges" data-field="history.{{ loop.index0 }}.chargeSessions"></td>
              <td data-label="Total kWh" data-field="history.{{ loop.index0 }}.totalkWh"></td>
            </tr>
        {% endfor %}
      {% endif %}
    </table>

    <p>&nbsp;</p>
    <h3>Vehicle Groups</h3>
    <table class="stack">
      <tr>
        <th>Group Name</th>
        <th>Members</th>
        <th>Description</th>
        <th>Actions</th>
      </tr>
      {% for group in master.settings["VehicleGroups"].keys()|sort %}
        <tr>
          <td data-label="Group"><b>{{ group }}</b></td>
          <td data-label="Members">
            {% for vehicle in master.settings["VehicleGroups"][group]["Members"] %}
              {{ vehicle }}<br/>
            {% endfor %}
          </td>
          <td data-label="Description">{{ master.settings["VehicleGroups"][group]["Description"] }}</td>
          <td>
            {% if master.settings["VehicleGroups"][group]["Built-in"] %}
            Delete
            {% else %}
            <a href="/vehicles/deleteGroup/{{ group|urlencode }}">Delete</a>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </table>

    <p>&nbsp;</p>
    <h5>Add Group</h5>
    {% if addGroupError %}
    <p style="color: red;">{{ addGroupError }}</p>
    {% endif %}
    <form method=POST action="/vehicle/addGroup">
    <label>Group Name <input name="name" /></label>
    <label>Description <input name="description" /></label>
    <input type=submit />
    </form>
  </body>
</html>
