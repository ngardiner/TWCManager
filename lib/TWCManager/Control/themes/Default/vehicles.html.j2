<!DOCTYPE html>
<html lang='en'>
  <head>
    <title>TWCManager</title>
    {% include 'bootstrap.html.j2' %}
    <script type="text/javascript" src="/static/js/compositor.js"></script>
    <script type="text/javascript" src="/static/js/vehicleImage.js"></script>
  </head>
  <body>
    {% include 'navbar.html.j2' %}
    <p>&nbsp;</p>
    <h3>Vehicles</h3>
    <table class="stack">
      <tr>
        <th></th>
        <th>VIN</th>
        <th>Name</th>
        <th>Presence</th>
        <th>Watch</th>
        <th>Providers</th>
        <th>Last seen</th>
        <th>Charge limit (car's own)</th>
      </tr>
      {% for v in registry.vehicles() %}
        {% set row = v.summary() %}
        <tr>
          <td class="picture">
            {% if not row.anonymous %}
            <a href="/vehicleDetail/{{ row.vin }}"><img class="vehicleImage thumbnail" hidden alt=""
                 data-vin="{{ row.vin }}" data-appearance="{{ row.appearance|tojson|forceescape }}"></a>
            {% endif %}
          </td>
          <td data-label="VIN">
            {% if row.anonymous %}Unknown car on TWC {{ row.point }}
            {% else %}<a href="/vehicleDetail/{{ row.vin }}">{{ row.vin }}</a>{% endif %}
          </td>
          <td data-label="Name">{{ row.name }}</td>
          <td data-label="Presence">{{ presence(v) }}</td>
          <td data-label="Watch">{{ watchLine(v) }}</td>
          <td data-label="Providers">{% for line in providerLines(v) %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</td>
          <td data-label="Last seen">{{ ageText(row.lastSeenAge) }} via {{ sourceName(row.lastSeenSource) }}</td>
          <td data-label="Charge limit (car's own)">{{ heldLimitText(v) }}</td>
        </tr>
      {% endfor %}
    </table>

    {% if addVehicleError %}
    <p style="color: red;">{{ addVehicleError }}</p>
    {% endif %}
    <form method=POST action="/vehicle/add">
      <b>Add vehicle by VIN</b>
      <input name="vin" maxlength="17" />
      <input type=submit value="Add vehicle" />
    </form>

    <p>&nbsp;</p>
    <h3>Charge history</h3>
    <table class="stack">
        <tr>
          <th>Vehicle VIN</th>
          <th>Charges</th>
          <th>Total kWh</th>
        </tr>
      {% if master.settings["Vehicles"] %}
        {% for vehicle in master.settings["Vehicles"].keys()|sort %}
            <tr>
              <td data-label="VIN"><a href="/vehicleDetail/{{ vehicle }}">{{ vehicle }}</a></td>
              <td data-label="Charges">{{ master.settings["Vehicles"][vehicle]["chargeSessions"] }}</td>
              <td data-label="Total kWh">{{ master.settings["Vehicles"][vehicle]["totalkWh"] }}</td>
            </tr>
        {% endfor %}
      {% endif %}
    </table>

    <p>&nbsp;</p>
    <h3>Vehicle Groups</h3>
    <table class="stack">
      <tr>
        <th>Group Name</th>
        <th>Members</th>
        <th>Description</th>
        <th>Actions</th>
      </tr>
      {% for group in master.settings["VehicleGroups"].keys()|sort %}
        <tr>
          <td data-label="Group"><b>{{ group }}</b></td>
          <td data-label="Members">
            {% for vehicle in master.settings["VehicleGroups"][group]["Members"] %}
              {{ vehicle }}<br/>
            {% endfor %}
          </td>
          <td data-label="Description">{{ master.settings["VehicleGroups"][group]["Description"] }}</td>
          <td>
            {% if master.settings["VehicleGroups"][group]["Built-in"] %}
            Delete
            {% else %}
            <a href="/vehicles/deleteGroup/{{group}}">Delete</a>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </table>

    <p>&nbsp;</p>
    <h5>Add Group</h5>
    <form method=POST action="/vehicle/group">
    <input type="hidden" name="operation" value="add" />
    <label>Group Name <input /></label>
    <label>Description <input /></label>
    <input type=submit />
    </form>
  </body>
</html>
