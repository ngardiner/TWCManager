<script>

// Live values: live.js fills the data-* hooks; this hook carries what is
// not text (the Charge Now buttons) and the navbar's server time.
Live.onData(function (data) {
  var chargeNow = data.currentPolicy == "Charge Now";
  var start = document.getElementById("start_chargenow");
  var cancel = document.getElementById("cancel_chargenow");
  if (start) {
    start.value = chargeNow ? "Update Charge Now" : "Start Charge Now";
  }
  if (cancel) {
    cancel.disabled = !chargeNow;
  }
  var serverTime = document.getElementById("currentServerTime");
  if (serverTime && data.currentServerTime != null) {
    serverTime.textContent = data.currentServerTime.split("&nbsp;").join(" ");
  }
});

Live.start({
  urls: ["/api/getStatus", "/api/getChargingPoints"],
  interval: 3000,
  fingerprint: {{ fingerprint("home")|tojson }}
});

$(document).ready(function() {
  $("#start_chargenow").click(function(e) {
    e.preventDefault();
    $.ajax({
      type: "POST",
      url: "/api/chargeNow",
      data: JSON.stringify({
        chargeNowRate: $("#chargeNowRate").val(),
        chargeNowDuration: $("#chargeNowDuration").val()
      }),
      dataType: "json"
    });
  });
});

</script>
