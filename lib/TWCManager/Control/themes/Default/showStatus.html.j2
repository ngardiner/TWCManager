<table width='100%'>
  <tr>
    <td width='60%'>
      <table class='table table-dark'>
        <tr>
          <th>Amps to share across all TWCs:</th>
          <td><div data-field='maxAmpsToDivideAmongSlaves'></div></td><td>amps</td>
        </tr>
        <tr>
          <th>Current Generation</th>
          <td><div data-field='generationWatts'></div></td><td>watts</td>
          <td><div data-field='generationAmps'></div></td><td>amps</td>
        </tr>
        <tr>
          <th>Current Consumption</th>
          <td><div data-field='consumptionWatts'></div></td><td>watts</td>
          <td><div data-field='consumptionAmps'></div></td><td>amps</td>
        </tr>
        <tr>
          <th>Current Charger Load</th>
          <td><div data-field='chargerLoadWatts'></div></td><td>watts</td>
        </tr>

        <tr>
          <th>Number of Cars Charging</th>
          <td>
            <div data-field='carsCharging'></div>
          </td>
          <td>cars</td>
        </tr>
      </table>
    </td>

    <td width='40%'>
      <table class='table table-dark'>
        <tr>
          <th>Current Policy</th>
          <td>
            <div data-field='currentPolicy'></div>
          </td>
        </tr>
        <tr>
          <th>Scheduled Charging Amps</th>
          <td><div data-field='ScheduledCharging.amps'></div></td>
        </tr>
        <tr>
          <th>Scheduled Charging Start Hour</th>
          <td><div data-field='scheduledChargingStartHour' data-format='scheduledStart'></div></td>
        </tr>
        <tr>
          <th>Scheduled Charging End Hour</th>
          <td><div data-field='scheduledChargingEndHour'></div></td>
        </tr>
        <tr>
          <th>Is a Green Policy?</th>
          <td><div data-field='isGreenPolicy'></div></td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td width = '100%' colspan = '2'>
      <table>
        <tr width = '100%'>
          <td width='65%'>
            <table class='table table-dark table-condensed table-striped'>
              <thead class='thead-dark'>
                <tr>
                  <th width='2%'>TWC ID</th>
                  <th width='1%'>State</th>
                  <th width='1%'>Version</th>
                  <th width='2%'>Max Amps</th>
                  <th width='2%'>Amps<br />Offered</th>
                  <th width='2%'>Amps<br />In Use</th>
                  <th width='2%'>Lifetime<br />kWh</th>
                  <th width='4%'>Voltage<br />per Phase<br />1 / 2 / 3</th>
                  <th width='2%'>Last Heartbeat</th>
                  <th width='6%'>Vehicle Connected<br />Current / Last</th>
                </tr>
              </thead>
              <tbody data-keyed-list="points" data-template="point-row"></tbody>
              <template id="point-row">
              <tr>
                <td><span data-field=".controllers" data-format="pointKind"></span> <span data-field=".gen2.twcid" data-format="blank"></span></td>
                <td><div><span data-field=".gen2.state" data-format="blank"></span><span data-field=".gen3.state" data-format="blank"></span></div></td>
                <td><div data-field=".gen2.version" data-format="blank"></div></td>
                <td><div><span data-field=".gen2.maxAmps" data-format="blank"></span><span data-show=".gen2" data-show-if="not" data-field=".maxAmps" data-format="round2"></span></div></td>
                <td><div data-field=".ampsOffered" data-format="round2"></div></td>
                <td><div data-field=".ampsDrawn"></div></td>
                <td><div data-field=".gen2.lifetimekWh" data-format="blank"></div></td>
                <td><span data-field=".volts" data-format="volts"></span></td>
                <td><span data-show=".gen2"><span data-field=".gen2.lastHeardAt" data-format="secondsSince"></span> sec</span></td>
                <td>C: <span class='VINClick' data-field=".gen2.currentVIN" data-format="blank"></span><span class='VINClick' data-show=".gen2" data-show-if="not" data-field=".vin" data-format="blank"></span>
                <span data-show=".gen2"><br />L: <span class='VINClick' data-field=".gen2.lastVIN" data-format="blank"></span></span></td>
              </tr>
              </template>
        <tr>
          <td><b>Total</b><td>&nbsp;</td><td>&nbsp;</td>
          <td><div data-field='total.maxAmps'></div></td>
          <td><div data-field='total.ampsOffered'></div></td>
          <td><div data-field='total.ampsDrawn'></div></td>
          <td><div data-field='total.lifetimekWh'></div></td>
        </tr>
      </table>
    </td>
  </tr>
</table>

  </tr>
  <tr>
    <td width = '100%' colspan = '2'>
      {% include 'showCommands.html.j2' %}
    </td>
  </tr>
</table>
